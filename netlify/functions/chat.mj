export default async function handler(req) {

  const headers = {
    "Content-Type": "application/json",
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Headers": "Content-Type",
    "Access-Control-Allow-Methods": "POST, OPTIONS"
  };

  if (req.method === "OPTIONS") {
    return new Response(null, {
      status: 204,
      headers
    });
  }

  if (req.method !== "POST") {
    return new Response(
      JSON.stringify({
        error: "Method Not Allowed"
      }),
      {
        status: 405,
        headers
      }
    );
  }

  try {

    const API_KEY =
      process.env.AI_API_KEY;

    const API_BASE =
      process.env.AI_API_BASE;

    const MODEL =
      process.env.AI_MODEL;

    if (!API_KEY) {

      return new Response(
        JSON.stringify({
          error:
            "AI_API_KEY در Netlify تنظیم نشده است."
        }),
        {
          status:500,
          headers
        }
      );

    }

    if (!API_BASE) {

      return new Response(
        JSON.stringify({
          error:
            "AI_API_BASE در Netlify تنظیم نشده است."
        }),
        {
          status:500,
          headers
        }
      );

    }

    if (!MODEL) {

      return new Response(
        JSON.stringify({
          error:
            "AI_MODEL در Netlify تنظیم نشده است."
        }),
        {
          status:500,
          headers
        }
      );

    }

    const body=await req.json();

    if(
      !body ||
      !Array.isArray(body.messages)
    ){

      return new Response(
        JSON.stringify({
          error:
            "messages معتبر نیست."
        }),
        {
          status:400,
          headers
        }
      );

    }

    /*
      محدودسازی اولیه درخواست
    */

    if(body.messages.length>30){

      return new Response(
        JSON.stringify({
          error:
            "تعداد پیام‌ها بیش از حد مجاز است."
        }),
        {
          status:400,
          headers
        }
      );

    }

    const url=
      API_BASE.replace(/\/+$/,"")+
      "/chat/completions";

    const upstream=
      await fetch(url,{

        method:"POST",

        headers:{
          "Content-Type":
            "application/json",

          "Authorization":
            `Bearer ${API_KEY}`
        },

        body:JSON.stringify({

          model:MODEL,

          messages:body.messages,

          temperature:
            typeof body.temperature==="number"
              ?body.temperature
              :.7,

          max_tokens:
            typeof body.max_tokens==="number"
              ?Math.min(body.max_tokens,5000)
              :3500

        })

      });

    const text=
      await upstream.text();

    let result;

    try{

      result=JSON.parse(text);

    }catch{

      result={
        error:text
      };

    }

    return new Response(
      JSON.stringify(result),
      {
        status:upstream.status,
        headers
      }
    );

  }catch(error){

    return new Response(
      JSON.stringify({
        error:
          error?.message||
          "خطای داخلی سرور"
      }),
      {
        status:500,
        headers
      }
    );
  }
}

export const config={
  path:"/api/chat"
};